      coinChange: 0
      requiredKarmaLevel: 0
      choiceStyle: 0
      conditions: []
      actions: []
    - choiceText: Don't offer the bread!
      inputLabel: X
      nextNodeId: node_11
      karmaChange: 0
      coinChange: 0
      requiredKarmaLevel: 0
      choiceStyle: 1
      conditions: []
      actions: []
    nextNodeId: neutral_response
    isEnd: 0
    conditions: []
    onShowActions: []
  - nodeId: end_selfish
    speakerName: Serna
    dialogueText: Anyways, only a blessed monk food can set me free from eating all
      this food falling from the sky!
    voiceClip: {fileID: 0}
    choices: []
    nextNodeId: quest_accepted
    isEnd: 0
    conditions: []
    onShowActions: []
  - nodeId: end_neutral
    speakerName: Serna
    dialogueText: Until then, I have to keep eating all this food falling from the
